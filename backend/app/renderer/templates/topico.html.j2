const slides = Array.from(document.querySelectorAll('.slide'));
let current = 0;

function checkGate(slideEl) {
  if (!slideEl || !slideEl.dataset.gate) return;
  const items = slideEl.querySelectorAll('.gate-item');
  const allAnswered = Array.from(items).every(function (it) { return it.dataset.answered; });
  const hint = slideEl.querySelector('[data-gate-hint]');
  if (slideEl.classList.contains('active')) {
    document.getElementById('nextBtn').disabled = !allAnswered;
    if (hint) hint.classList.toggle('show', !allAnswered);
  }
  slideEl.dataset.unlocked = allAnswered ? '1' : '';
  // Assim que TODOS os checkpoints/avaliações do tópico estão respondidos, já
  // monta o resumo (e, se embutido no Emaús, entrega pro pai via postMessage) —
  // sem depender do aluno clicar "Próximo" até o slide de resultado. Achado real
  // (2026-09-10): aluno responde a última pergunta, clica "Enviar meu resumo" no
  // painel do Emaús (que aparece embaixo) em vez de "Próximo ▶", e o resumo ainda
  // não existia — o botão não fazia nada.
  if (allAnswered) {
    var gates = document.querySelectorAll('.slide[data-gate]');
    var todosOk = Array.from(gates).every(function (g) { return g.dataset.unlocked; });
    if (todosOk) buildSummary();
  }
}

function showSlide(idx) {
  stopSpeech();
  slides.forEach(function (s, i) { s.classList.toggle('active', i === idx); });
  current = idx;
  const slideEl = slides[idx];
  document.getElementById('slideCount').textContent = (idx + 1) + '/' + slides.length;
  document.getElementById('progressFill').style.width = ((idx + 1) / slides.length * 100) + '%';
  document.getElementById('sectionLabel').textContent = slideEl.dataset.section || '';
  document.getElementById('prevBtn').disabled = idx === 0;
  const nextBtn = document.getElementById('nextBtn');
  nextBtn.textContent = idx === slides.length - 1 ? 'Fim' : 'Próximo ▶';
  if (slideEl.dataset.gate) { checkGate(slideEl); } else { nextBtn.disabled = false; }
  if (idx === slides.length - 1) buildSummary();

  // Painel de anotação flutuante: se estiver aberto na aba "Anotar este
  // slide", troca o texto pro slide novo (a função só existe fora do
  // contexto de revisão — ver bloco de anotação acima).
  if (typeof atualizarTextoAnotacaoAtual === 'function' && anotacaoPainel && !anotacaoPainel.hidden) {
    var abaAnotar = document.querySelector('.anotacao-tab[data-aba="anotar"]');
    if (abaAnotar && abaAnotar.classList.contains('active')) atualizarTextoAnotacaoAtual();
  }

  // Avisa o pai (front Emaús, área de revisão) qual slide está na tela — inócuo fora
  // de iframe. O aluno não usa isso; é o painel do professor que escuta.
  try {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({
        tipo: 'emaus:slide',
        indice: idx,
        total: slides.length,
        secao: slideEl.dataset.section || '',
        temImagem: !!slideEl.querySelector('img'),
      }, '*');
    }
  } catch (e) {}

  salvarSlideRemoto(idx);
}

document.getElementById('prevBtn').addEventListener('click', function () { if (current > 0) showSlide(current - 1); });
document.getElementById('nextBtn').addEventListener('click', function () {
  if (current < slides.length - 1) { showSlide(current + 1); return; }
  // Já está no slide "Resultado" (último) e clicou em "Fim" de novo — se
  // embutido no Emaús, é ESTE clique que dispara o envio pro Tutor (achado
  // real, 2026-09-10: tinha um botão "Enviar meu resumo" separado no painel
  // do Emaús, o aluno não via porque já achava que tinha terminado ao
  // responder a última pergunta). Fora de iframe (uso pessoal) não faz nada
  // novo — o resumo pra copiar já está na tela.
  if (!EMBUTIDO) return;
  buildSummary();
  ultimoResumoEnviado = document.getElementById('summaryText').value;
  mostrarEstadoAvaliacao('avaliacaoCarregando');
  try {
    window.parent.postMessage({ tipo: 'emaus:concluir', texto: ultimoResumoEnviado }, '*');
  } catch (e) {}
});
document.addEventListener('keydown', function (e) {
  if (e.key === 'ArrowRight') document.getElementById('nextBtn').click();
  if (e.key === 'ArrowLeft') document.getElementById('prevBtn').click();
});

const speedLevels = [0.65, 0.8, 1.0, 1.2, 1.4];
const speedLabels = ['0.65x', '0.8x', '1x', '1.2x', '1.4x'];
let speedIdx = 2;
(function loadSavedSpeed() {
  const saved = parseInt(localStorage.getItem('gcTtsSpeedIdx'), 10);
  if (!isNaN(saved) && saved >= 0 && saved < speedLevels.length) speedIdx = saved;
})();
const speedBtn = document.getElementById('speedBtn');
function updateSpeedLabel() { speedBtn.textContent = speedLabels[speedIdx]; }
updateSpeedLabel();
speedBtn.addEventListener('click', function () {
  const wasSpeaking = speaking;
  speedIdx = (speedIdx + 1) % speedLevels.length;
  localStorage.setItem('gcTtsSpeedIdx', String(speedIdx));
  updateSpeedLabel();
  if (wasSpeaking) { stopSpeech(); speakCurrentSlide(); }
});

let speaking = false;
function stopSpeech() {
  if ('speechSynthesis' in window) window.speechSynthesis.cancel();
  speaking = false;
  document.getElementById('audioBtn').classList.remove('speaking');
}
function speakCurrentSlide() {
  if (!('speechSynthesis' in window)) { alert('Seu navegador não suporta leitura em voz alta.'); return; }
  const slideEl = slides[current];
  const inner = slideEl.querySelector('.slide-inner');
  const text = inner.dataset.narracao ? JSON.parse(inner.dataset.narracao) : inner.innerText;
  const utter = new SpeechSynthesisUtterance(text);
  utter.lang = 'pt-BR';
  utter.rate = speedLevels[speedIdx];
  utter.onend = function () { stopSpeech(); };
  utter.onerror = function () { stopSpeech(); };
  window.speechSynthesis.cancel();
  window.speechSynthesis.speak(utter);
  speaking = true;
  document.getElementById('audioBtn').classList.add('speaking');
}
document.getElementById('audioBtn').addEventListener('click', function () { if (speaking) { stopSpeech(); return; } speakCurrentSlide(); });

function updateStatsLive() { if (current === slides.length - 1 || document.body.dataset.modo === 'corrido') buildSummary(); }

function buildSummary() {
  let correctCount = 0, objectiveTotal = 0, flags = [], openCount = 0;
  const lines = ['=== RESUMO — Tópico ' + TOPICO_NUMERO + ': ' + TOPICO_TITULO + ' ==='];

  QUESTION_ORDER.forEach(function (q) {
    const st = state[q.id];
    if (!st) { lines.push(q.label + ': (não respondido)'); return; }
    if (st.correct !== null) {
      objectiveTotal++;
      if (st.correct) correctCount++;
      if (st.correct === false && st.confidence === 'alta') flags.push(q.label);
      lines.push(q.label + ': ' + (st.correct ? 'ACERTOU' : 'ERROU') + ' (confiança: ' + (st.confidence || 'não marcada') + ')');
    } else if (st.text) {
      openCount++;
      lines.push(q.label + ' (confiança: ' + (st.confidence || 'não marcada') + '):\n  "' + st.text + '"');
    }
  });

  lines.push('');
  lines.push('Pontuação objetiva: ' + correctCount + '/' + objectiveTotal);
  lines.push('Sinalizações (alta confiança + errou): ' + (flags.length ? flags.join(', ') : 'nenhuma'));
  lines.push('Questões abertas registradas: ' + openCount + '/' + OPEN_TOTAL);
  lines.push('');
  lines.push('Peço avaliação honesta como especialista: devo seguir para ' + PROXIMO_TOPICO_LABEL + ' ou preciso de reforço antes?');

  document.getElementById('statScore').textContent = correctCount + ' / ' + objectiveTotal;
  document.getElementById('statFlags').textContent = flags.length;
  document.getElementById('statOpen').textContent = openCount + ' / ' + OPEN_TOTAL;
  document.getElementById('summaryText').value = lines.join('\n');

  // Quando embutido num iframe (front Emaús), entrega o resumo pronto pro pai —
  // que oferece "enviar pro tutor" sem o aluno ter que copiar/colar. Inócuo fora
  // de iframe (o botão "Copiar resumo" continua funcionando igual).
  try {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage(
        { tipo: 'emaus:resumo', topico: TOPICO_NUMERO, texto: lines.join('\n') },
        '*'
      );
    }
  } catch (e) {}
}

document.getElementById('copyBtn') && document.getElementById('copyBtn').addEventListener('click', function () {
  const ta = document.getElementById('summaryText');
  ta.select();
  navigator.clipboard.writeText(ta.value).then(function () {
    const btn = document.getElementById('copyBtn');
    btn.textContent = 'Copiado! ✔';
    btn.classList.add('copied');
    setTimeout(function () { btn.textContent = 'Copiar resumo'; btn.classList.remove('copied'); }, 2000);
  });
});

const fullscreenBtn = document.getElementById('fullscreenBtn');
// iOS Safari não suporta a Fullscreen API padrão pra elementos genéricos (só
// <video>) — requestFullscreen() nem existe ou rejeita a Promise. Nesses
// casos caímos num "modo tela cheia" via CSS + postMessage pro Next.js pai
// esconder a barra "Voltar ao curso" e o iframe ocupar a tela toda.
let fallbackFullscreen = false;
function avisarPai(ligado) {
  try { window.parent.postMessage({ tipo: 'emaus:fullscreen-toggle', ligado: ligado }, '*'); } catch (e) {}
}
function syncFullscreenUI() {
  const on = !!document.fullscreenElement || fallbackFullscreen;
  document.body.classList.toggle('is-fullscreen', on);
  fullscreenBtn.textContent = on ? '✕' : '⛶';
  fullscreenBtn.title = on ? 'Sair da tela cheia' : 'Tela cheia';
}
fullscreenBtn.addEventListener('click', function () {
  if (document.fullscreenElement) { document.exitFullscreen().catch(function () {}); return; }
  if (fallbackFullscreen) { fallbackFullscreen = false; syncFullscreenUI(); avisarPai(false); return; }
  if (document.documentElement.requestFullscreen) {
    document.documentElement.requestFullscreen().catch(function () {
      fallbackFullscreen = true; syncFullscreenUI(); avisarPai(true);
    });
  } else {
    fallbackFullscreen = true; syncFullscreenUI(); avisarPai(true);
  }
});
document.addEventListener('fullscreenchange', syncFullscreenUI);

// Abre no slide onde o aluno parou (2026-09-15), não sempre no 0 — mesma regra
// de RESPOSTAS_ATIVO (revisão/uso avulso sempre abre no início, como antes).
function abrirSlideInicial() {
  if (!RESPOSTAS_ATIVO) { showSlide(0); return; }
  fetch(window.location.origin + '/topico-progress/' + RESPOSTAS_TOPICO_ID_DB + '/slide', {
    headers: { 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
  })
    .then(function (r) { return r.ok ? r.json() : {}; })
    .then(function (d) {
      var idx = d && typeof d.ultimo_slide === 'number' ? d.ultimo_slide : 0;
      if (idx < 0 || idx >= slides.length) idx = 0;
      showSlide(idx);
    })
    .catch(function (e) {
      console.error('falha ao carregar slide salvo', e);
      showSlide(0);
    });
}
abrirSlideInicial();

// Modo Corrido / Slide — a fila de revisão do professor (/revisao/topico/[id])
// abre este render com ?contexto=revisao na URL do iframe porque depende de
// saber "qual slide está na tela" (postMessage emaus:slide, showSlide() acima)
// pra sincronizar os comentários por slide — nesse contexto o toggle nem aparece,
// fica sempre em modo Slide, do jeito que a revisão já espera.
(function () {
  var modoBtn = document.getElementById('modoBtn');
  var isRevisao = new URLSearchParams(window.location.search).get('contexto') === 'revisao';

  function aplicarModo(modo) {
    document.body.dataset.modo = modo;
    var corrido = modo === 'corrido';
    document.documentElement.style.overflow = corrido ? 'auto' : '';
    document.documentElement.style.height = corrido ? 'auto' : '';
    document.body.style.overflow = corrido ? 'auto' : '';
    document.body.style.height = corrido ? 'auto' : '';
    modoBtn.textContent = corrido ? '▤ Slide' : '☰ Corrido';
    try { localStorage.setItem('emausTopicoModo', modo); } catch (e) {}
    if (corrido) { stopSpeech(); buildSummary(); }
  }

  if (isRevisao) {
    modoBtn.hidden = true;
    return;
  }

  modoBtn.addEventListener('click', function () {
    aplicarModo(document.body.dataset.modo === 'corrido' ? 'slide' : 'corrido');
  });

  var modoSalvo = 'slide';
  try { modoSalvo = localStorage.getItem('emausTopicoModo') || 'slide'; } catch (e) {}
  if (modoSalvo === 'corrido') aplicarModo('corrido');
})();

// Botão "📄 PDF" — só aparece com ?pdf=1 na URL (o emaus-web passa isso pro
// iframe quando o usuário é professor/admin/master). O @media print já força o
// layout de artigo em paleta clara, então aqui é só abrir a caixa de impressão.
(function () {
  var pdfBtn = document.getElementById('pdfBtn');
  if (!pdfBtn) return;
  var querPdf = new URLSearchParams(window.location.search).get('pdf') === '1';
  if (!querPdf) { pdfBtn.hidden = true; return; }
  pdfBtn.hidden = false;
  pdfBtn.addEventListener('click', function () {
    if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    window.print();
  });
})();

{% if cores_dark_json %}
// Toggle Escuro/Claro — só existe pra temas que definem 'coresDark' em temas.json.
// Troca as CSS custom properties direto no client (sem re-render), preferência em
// localStorage, mesmo padrão do toggle Corrido/Slide acima.
(function () {
  var temaBtn = document.getElementById('temaBtn');
  if (!temaBtn) return;
  var isRevisao = new URLSearchParams(window.location.search).get('contexto') === 'revisao';
  if (isRevisao) { temaBtn.hidden = true; return; }

  var coresClaras = {{ tema.cores | tojson }};
  var coresEscuras = {{ cores_dark_json | safe }};
  var mapaVar = {
    bg: '--bg', surface: '--surface', surface2: '--surface-2', border: '--border',
    borderSoft: '--border-soft', text: '--text', textMuted: '--text-muted',
    textDim: '--text-dim', accent: '--accent', accentSoft: '--accent-soft',
    accentTextOn: '--accent-text-on', bad: '--bad', badSoft: '--bad-soft',
    blue: '--blue', amber: '--amber', violet: '--violet'
  };

  function aplicarTema(escuro) {
    var cores = escuro ? coresEscuras : coresClaras;
    Object.keys(mapaVar).forEach(function (chave) {
      if (cores[chave]) document.documentElement.style.setProperty(mapaVar[chave], cores[chave]);
    });
    temaBtn.textContent = escuro ? '☀ Claro' : '🌙 Escuro';
    try { localStorage.setItem('emausTopicoTema', escuro ? 'escuro' : 'claro'); } catch (e) {}
  }

  temaBtn.addEventListener('click', function () {
    aplicarTema(temaBtn.textContent.indexOf('Escuro') !== -1);
  });

  var temaSalvo = 'claro';
  try { temaSalvo = localStorage.getItem('emausTopicoTema') || 'claro'; } catch (e) {}
  if (temaSalvo === 'escuro') aplicarTema(true);
})();
{% endif %}
</script>

</body>
</html>
