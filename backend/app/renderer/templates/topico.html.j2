{% macro render_bloco_audio(bloco) -%}
  {% if bloco.audio_url %}
  <button type="button" class="bloco-audio" data-audio-url="{{ bloco.audio_url }}">🎧 Ouvir explicação</button>
  {% endif %}
{%- endmacro %}

{% macro render_box(bloco) -%}
  <div class="box box-{{ bloco.variante }}">
    {% if bloco.label %}<div class="box-label">{{ bloco.label }}</div>{% endif %}
    {% if bloco.itens %}
    <ul style="margin:4px 0; padding-left:20px;">
      {% for item in bloco.itens %}<li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% else %}
    {{ bloco.texto }}
    {% endif %}
  </div>
  {{ render_bloco_audio(bloco) }}
{%- endmacro %}

{% macro render_diagrama(bloco) -%}
  {% if bloco.figcaption %}
  <figure>
    <div class="fig-wrap">{{ bloco.svg_raw | safe }}</div>
    <figcaption>{{ bloco.figcaption }}</figcaption>
  </figure>
  {% else %}
  {{ bloco.svg_raw | safe }}
  {% endif %}
{%- endmacro %}

{% macro render_vocab(bloco) -%}
  <article class="vocab-entry">
    <div class="vocab-head">
      <span class="vocab-termo">{{ bloco.termo }}</span>
      <button type="button" class="vocab-listen" data-say="{{ bloco.termo }}" aria-label="Ouvir pronúncia" title="Ouvir pronúncia">🔊</button>
      {% if bloco.classe_gramatical %}<span class="vocab-classe">{{ bloco.classe_gramatical }}</span>{% endif %}
    </div>
    <p class="vocab-traducao">{{ bloco.traducao }}</p>
    {% if bloco.exemplo_en %}
    <div class="vocab-exemplo">
      <span class="vocab-exemplo-en">
        {{ bloco.exemplo_en }}
        <button type="button" class="vocab-listen vocab-listen-exemplo" data-say="{{ bloco.exemplo_en }}" aria-label="Ouvir exemplo" title="Ouvir exemplo">🔊</button>
      </span>
      {% if bloco.exemplo_pt %}<span class="vocab-exemplo-pt">{{ bloco.exemplo_pt }}</span>{% endif %}
    </div>
    {% endif %}
    {% if bloco.cuidado %}
    <p class="vocab-cuidado"><span aria-hidden>⚠</span> {{ bloco.cuidado }}</p>
    {% endif %}
  </article>
{%- endmacro %}

{% macro render_fluxo(bloco) -%}
  <ol class="fluxo-lista">
    {% for passo in bloco.passos %}
    <li{% if passo.decisao %} class="fluxo-decisao"{% endif %}>{{ passo.texto }}</li>
    {% endfor %}
  </ol>
{%- endmacro %}

{% macro render_bloco(bloco) -%}
  {% if bloco.tipo == 'paragrafo' %}
    <p>{{ bloco.texto }}</p>
    {{ render_bloco_audio(bloco) }}
  {% elif bloco.tipo == 'box' %}
    {{ render_box(bloco) }}
  {% elif bloco.tipo == 'cols2' %}
    <div class="cols2">
      {{ render_box(bloco.esquerda) }}
      {{ render_box(bloco.direita) }}
    </div>
  {% elif bloco.tipo == 'timeline' %}
    <div class="timeline">
      {% for item in bloco.itens %}
      <div class="tl-item">
        <div class="tl-dot" style="background:{{ item.cor }};">{{ item.numero }}</div>
        <div class="tl-title">{{ item.titulo }}</div>
        <div class="tl-desc">{{ item.descricao }}</div>
      </div>
      {% endfor %}
    </div>
  {% elif bloco.tipo == 'badges' %}
    <div class="badge-row">
      {% for item in bloco.itens %}<span class="badge">{{ item }}</span>
      {% endfor %}
    </div>
  {% elif bloco.tipo == 'cards' %}
    <div class="type-cards">
      {% for item in bloco.itens %}
      <div class="type-card">
        <span class="type-card-icon">{{ item.icone }}</span>
        <div class="type-card-name">{{ item.nome }}</div>
        <div class="type-card-desc">{{ item.descricao }}</div>
      </div>
      {% endfor %}
    </div>
  {% elif bloco.tipo == 'quote' %}
    <div class="quote-block">{{ bloco.texto }}</div>
  {% elif bloco.tipo == 'vocab' %}
    {{ render_vocab(bloco) }}
  {% elif bloco.tipo == 'fluxo' %}
    {{ render_fluxo(bloco) }}
  {% elif bloco.tipo == 'diagrama' %}
    {{ render_diagrama(bloco) }}
  {% elif bloco.tipo == 'imagem_sugerida' %}
    {% if bloco.url %}
    <figure class="fig-wrap" style="padding:0; overflow:hidden;">
      <img src="{{ bloco.url }}" alt="{{ bloco.alt or bloco.descricao }}" style="width:100%; display:block; border-radius: var(--radius-lg);">
      {% if bloco.legenda %}<figcaption style="font-size:12px; color:var(--text-muted); padding:8px 12px;">{{ bloco.legenda }}</figcaption>{% endif %}
    </figure>
    {% else %}
    <div class="box box-instr">
      <div class="box-label">🖼️ Imagem sugerida (placeholder — nenhuma imagem foi gerada)</div>
      {{ bloco.descricao }}
    </div>
    {% endif %}
  {% elif bloco.tipo == 'audio_video' %}
    {% if bloco.url %}
    <figure class="fig-wrap" style="padding:0; overflow:hidden;">
      {% if bloco.midia_tipo == 'audio' %}
      <audio controls style="width:100%; display:block;" src="{{ bloco.url }}"></audio>
      {% else %}
      <div style="position:relative; padding-top:56.25%;">
        <iframe src="{{ bloco.url }}" title="{{ bloco.legenda or 'vídeo' }}" style="position:absolute; inset:0; width:100%; height:100%; border:0;" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
      {% endif %}
      {% if bloco.legenda %}<figcaption style="font-size:12px; color:var(--text-muted); padding:8px 12px;">{{ bloco.legenda }}</figcaption>{% endif %}
    </figure>
    {% else %}
    <div class="box box-instr">
      <div class="box-label">{{ '🔊 Áudio sugerido' if bloco.midia_tipo == 'audio' else '🎬 Vídeo sugerido' }} (placeholder — nenhuma mídia foi gerada)</div>
      {{ bloco.legenda or bloco.descricao }}
    </div>
    {% endif %}
  {% endif %}
{%- endmacro %}

{% macro render_confidence(qid) -%}
  <div class="confidence" data-confidence="{{ qid }}">Confiança:
    <button data-c="baixa">Baixa</button><button data-c="media">Média</button><button data-c="alta">Alta</button>
  </div>
{%- endmacro %}

{% macro render_pergunta(p) -%}
  <div class="question" data-qid="{{ p.id }}">
    <div class="q-meta">
      <span class="q-type">
        {%- if p.tipo == 'mc' -%}Múltipla escolha
        {%- elif p.tipo == 'tf' -%}Verdadeiro / Falso
        {%- elif p.tipo == 'classify' -%}Classificação
        {%- elif p.tipo == 'associar' -%}Associação
        {%- elif p.tipo == 'lacuna' -%}Complete a lacuna
        {%- elif p.tipo == 'open' -%}Aplicação aberta
        {%- elif p.tipo == 'ditado' -%}Ouça e escreva
        {%- endif -%}
      </span>
    </div>
    {% if p.cenario %}<div class="q-scenario">{{ p.cenario }}</div>{% endif %}
    <div class="q-text">{{ p.enunciado }}</div>
    {{ render_confidence(p.id) }}

    {% if p.tipo == 'mc' %}
    <div class="opts gate-item" data-correct="{{ p.correta_idx }}" data-qid="{{ p.id }}">
      {% for opcao in p.opcoes %}
      <button class="opt-btn" data-i="{{ loop.index0 }}">{{ opcao }}</button>
      {% endfor %}
    </div>
    {% elif p.tipo == 'tf' %}
    <div class="tf-row gate-item" data-correct-tf="{{ 'verdadeiro' if p.correta_bool else 'falso' }}" data-qid="{{ p.id }}">
      <button class="tf-btn" data-v="verdadeiro">Verdadeiro</button>
      <button class="tf-btn" data-v="falso">Falso</button>
    </div>
    {% elif p.tipo == 'classify' or p.tipo == 'associar' %}
    <div data-gate-group="{{ p.id }}" data-tipo="{{ p.tipo }}">
      {% for item in p.itens %}
      <div class="classify-item gate-item" data-correct="{{ item.correta }}" data-qid="{{ item.id }}">
        <span class="classify-label">{{ item.texto }}</span>
        <span class="classify-btns">
          {% for opcao in p.rotulos_opcoes %}
          <button data-v="{{ opcao.valor }}">{{ opcao.rotulo }}</button>
          {% endfor %}
        </span>
      </div>
      {% endfor %}
    </div>
    {% elif p.tipo == 'lacuna' %}
    <div class="lacuna-wrap gate-item" data-qid="{{ p.id }}" data-answers='{{ p.respostas_aceitas | tojson }}'>
      <input type="text" class="lacuna-input" placeholder="{{ p.placeholder or 'Digite sua resposta' }}">
      <button class="register-btn lacuna-check-btn">Corrigir</button>
    </div>
    {% elif p.tipo == 'open' %}
    <textarea data-open="{{ p.id }}" placeholder="{{ p.placeholder }}"></textarea>
    <button class="register-btn gate-item" data-qid="{{ p.id }}" data-register="{{ p.id }}">Registrar resposta</button>
    {% if p.resposta_modelo %}
    <button class="reveal-btn" data-target="{{ p.id }}-modelo">Ver resposta-modelo</button>
    <div class="explanation" data-exp="{{ p.id }}-modelo">{{ p.resposta_modelo }}</div>
    {% endif %}
    {% elif p.tipo == 'ditado' %}
    <div class="ditado-wrap gate-item" data-qid="{{ p.id }}" data-answers='{{ p.respostas_aceitas | tojson }}'>
      <button type="button" class="vocab-listen ditado-play" data-say="{{ p.frase_audio }}" aria-label="Ouvir a frase" title="Ouvir a frase (pode repetir quantas vezes precisar)">🔊 Ouvir a frase</button>
      <input type="text" class="lacuna-input ditado-input" placeholder="{{ p.placeholder or 'Escreva exatamente o que você ouviu' }}">
      <button class="register-btn ditado-check-btn">Corrigir</button>
    </div>
    {% endif %}

    {% if p.explicacao %}<div class="explanation" data-exp="{{ p.id }}">{{ p.explicacao }}</div>{% endif %}
  </div>
{%- endmacro %}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ content.titulo }} — Tópico {{ content.numero }} (estudo em slides)</title>
{% if tema.googleFonts %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ tema.googleFonts }}" rel="stylesheet">
{% endif %}
<style>
  * { box-sizing: border-box; }
  :root {
    --bg: {{ tema.cores.bg }};
    --surface: {{ tema.cores.surface }};
    --surface-2: {{ tema.cores.surface2 }};
    --border: {{ tema.cores.border }};
    --border-soft: {{ tema.cores.borderSoft }};
    --text: {{ tema.cores.text }};
    --text-muted: {{ tema.cores.textMuted }};
    --text-dim: {{ tema.cores.textDim }};
    --accent: {{ tema.cores.accent }};
    --accent-soft: {{ tema.cores.accentSoft }};
    --accent-text-on: {{ tema.cores.accentTextOn }};
    --bad: {{ tema.cores.bad }};
    --bad-soft: {{ tema.cores.badSoft }};
    --blue: {{ tema.cores.blue }};
    --amber: {{ tema.cores.amber }};
    --violet: {{ tema.cores.violet }};
    --radius: {{ tema.radius }};
    --radius-lg: {{ tema.radiusLg }};
    --font-display: {{ tema.fontFamilyDisplay | default(tema.fontFamily) }};
    --font-label: {{ tema.fontFamilyLabel | default(tema.fontFamily) }};
  }
  html, body {
    margin: 0; padding: 0;
    font-family: {{ tema.fontFamily }};
    color: var(--text);
    background: var(--bg);
    height: 100%;
    overflow: hidden;
  }

  .topbar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    color: var(--text);
    padding: 13px 16px 11px;
    border-bottom: 1px solid var(--border-soft);
  }
  .topbar-row { display: flex; justify-content: space-between; align-items: center; font-size: 11.5px; gap: 10px; }
  .topbar-title { font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); font-size: 10.5px; }
  .topbar-right { display: flex; align-items: center; gap: 10px; }
  .topbar-count { color: var(--text-dim); font-variant-numeric: tabular-nums; }
  .fullscreen-btn {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: var(--radius-lg);
    border: 1px solid var(--border); background: var(--surface);
    color: var(--text); font-size: 12px; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background .2s ease, transform .15s ease;
  }
  .fullscreen-btn:hover { background: var(--surface-2); }
  .fullscreen-btn:active { transform: scale(.92); }
  .modo-btn { width: auto; padding: 0 10px; font-family: var(--font-label); font-size: 10px; letter-spacing: .03em; white-space: nowrap; }
  .modo-btn[hidden] { display: none; }

  body[data-modo="corrido"] .slide { display: block !important; position: static; height: auto; overflow: visible; padding-bottom: 36px; margin-bottom: 10px; border-bottom: 1px solid var(--border-soft); animation: none !important; }
  body[data-modo="corrido"] .slide:last-child { border-bottom: none; }
  body[data-modo="corrido"] .navbar,
  body[data-modo="corrido"] .topbar-count,
  body[data-modo="corrido"] .progress-track { display: none; }
  body[data-modo="corrido"] .slides { height: auto; overflow: visible; padding-bottom: 0; }
  .progress-track { height: 2px; background: var(--border-soft); margin-top: 10px; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent); width: 0%; transition: width 0.4s cubic-bezier(.4,0,.2,1); }
  .section-label { font-size: 9.5px; text-transform: uppercase; letter-spacing: 1.8px; color: var(--text-dim); margin-top: 8px; font-weight: 600; }

  .slides { height: 100%; padding-top: 72px; padding-bottom: 82px; overflow: hidden; background: var(--bg); }
  .slide { display: none; height: 100%; overflow-y: auto; padding: 26px 20px 32px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
  .slide::-webkit-scrollbar { width: 7px; }
  .slide::-webkit-scrollbar-thumb { background: var(--border); border-radius: 6px; }
  .slide::-webkit-scrollbar-track { background: transparent; }
  .slide.active { display: block; animation: slideIn .4s cubic-bezier(.16,1,.3,1) both; position: relative; z-index: 1; }
  @keyframes slideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .slide.active { animation: none; } }
  .slide-inner { max-width: 640px; margin: 0 auto; }

  .conteudo-split { display: flex; flex-direction: column; gap: 22px; }
  .conteudo-split .conteudo-figura { margin: 0; }
  @media (min-width: 760px) {
    .conteudo-split { flex-direction: row; align-items: flex-start; gap: 32px; }
    .conteudo-split.flip { flex-direction: row-reverse; }
    .conteudo-split .conteudo-texto { flex: 1.3; min-width: 0; }
    .conteudo-split .conteudo-figura { flex: 1; min-width: 0; position: sticky; top: 88px; }
  }

  h1.title { font-family: var(--font-display); font-size: 24px; color: var(--text); margin: 0 0 8px 0; font-weight: {{ tema.pesoTitulo }}; line-height: 1.28; letter-spacing: -.3px; }
  h2.sub { font-size: 14px; color: var(--text-muted); font-weight: 400; margin: 0 0 20px 0; line-height: 1.55; }
  h3.section-h { font-family: var(--font-display); font-size: 15px; color: var(--text); margin: 22px 0 11px 0; font-weight: 600; display: flex; align-items: center; gap: 9px; letter-spacing: .2px; }
  h3.section-h::before { content: ""; width: 3px; height: 15px; background: var(--accent); flex-shrink: 0; }
  .section-head { display: flex; align-items: baseline; gap: 14px; margin: 22px 0 11px; flex-wrap: wrap; }
  .section-head h3.section-h { margin: 0; }
  .section-head.numerado h3.section-h::before { display: none; }
  .section-numero { font-family: var(--font-label); font-size: 11.5px; letter-spacing: .06em; color: var(--accent); white-space: nowrap; }
  p { margin: 8px 0; font-size: 15px; line-height: 1.65; color: var(--text); }
  strong { color: var(--accent); font-weight: 600; }
  code { font-family: 'SF Mono', 'Courier New', monospace; background: var(--surface-2); padding: 2px 6px; border-radius: 3px; color: var(--accent); font-size: 13px; }

  .box { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius); padding: 15px 16px; margin: 12px 0; font-size: 14.5px; line-height: 1.6; white-space: pre-line; }
  .box-label { font-family: var(--font-label); font-size: 10px; font-weight: 700; letter-spacing: {{ tema.letterSpacingLabel }}; text-transform: uppercase; margin-bottom: 7px; }
  .box-def { border-left: 2px solid var(--blue); } .box-def .box-label { color: var(--blue); }
  .box-analogy { border-left: 2px solid var(--amber); } .box-analogy .box-label { color: var(--amber); }
  .box-app { border-left: 2px solid var(--accent); } .box-app .box-label { color: var(--accent); }
  .box-error { border-left: 2px solid var(--bad); } .box-error .box-label { color: var(--bad); }
  .box-summary { border-left: 2px solid var(--violet); } .box-summary .box-label { color: var(--violet); }
  .box-instr { border-left: 2px solid var(--blue); font-size: 13.5px; } .box-instr .box-label { color: var(--blue); }
  .capa-imagem { width: 100%; max-height: 320px; object-fit: cover; border-radius: var(--radius-lg); border: 1px solid var(--border-soft); margin: 14px 0 18px; display: block; }

  .quote-block { font-family: var(--font-display); font-style: italic; font-size: 16px; color: var(--text-muted); border-left: 2px solid var(--border); padding: 4px 0 4px 14px; margin: 18px 0; font-weight: 300; }

  .cols2 { display: flex; gap: 10px; flex-wrap: wrap; }
  .cols2 > div { flex: 1; min-width: 240px; }

  .badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
  .badge { font-family: var(--font-label); font-size: 10.5px; background: var(--surface-2); border: 1px solid var(--border-soft); color: var(--text-muted); padding: 6px 11px; border-radius: 20px; font-weight: 500; }

  .roadmap { display: flex; flex-direction: column; gap: 8px; margin: 18px 0; }
  .roadmap-item { display: flex; align-items: center; gap: 11px; background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius); padding: 11px 13px; font-size: 13.5px; color: var(--text-muted); transition: border-color .15s ease; }
  .roadmap-item:hover { border-color: var(--border); }
  .roadmap-num { width: 20px; height: 20px; border-radius: 50%; border: 1px solid var(--accent); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; }

  .type-cards { display: grid; grid-template-columns: 1fr; gap: 10px; margin: 14px 0; }
  @media (min-width: 480px) { .type-cards { grid-template-columns: 1fr 1fr; } }
  .type-card { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 13px 14px; transition: border-color .15s ease; }
  .type-card:hover { border-color: var(--border); }
  .type-card-icon { font-size: 20px; margin-bottom: 6px; display: block; }
  .type-card-name { font-weight: 600; font-size: 13.5px; color: var(--text); margin-bottom: 4px; }
  .type-card-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }

  .vocab-entry { padding: 20px 0; border-top: 1px solid var(--border-soft); }
  .vocab-entry:first-child { border-top: none; padding-top: 0; }
  .vocab-head { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .vocab-termo { font-family: var(--font-display); font-style: italic; font-weight: 700; font-size: 18px; color: var(--accent); }
  .vocab-listen { flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--border-soft); background: var(--surface-2); color: var(--accent); font-size: 11px; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: border-color .15s ease, transform .12s ease; }
  .vocab-listen:hover { border-color: var(--accent); }
  .vocab-listen:active { transform: scale(.9); }
  .vocab-classe { font-family: var(--font-label); font-size: 9.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); border: 1px solid var(--border-soft); padding: 2px 6px; border-radius: 3px; }
  .vocab-traducao { font-size: 14px; color: var(--text-muted); margin: 5px 0 10px; }
  .vocab-exemplo { padding-left: 14px; border-left: 2px solid var(--border); margin-bottom: 8px; font-size: 13.5px; line-height: 1.55; }
  .vocab-exemplo-en { display: block; color: var(--text); font-style: italic; }
  .vocab-exemplo-pt { display: block; color: var(--text-dim); font-size: 12px; margin-top: 3px; }
  .vocab-listen-exemplo { width: 17px; height: 17px; font-size: 9px; vertical-align: middle; margin-left: 6px; }
  .ditado-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: 6px; }
  .ditado-play { width: auto; height: auto; border-radius: 999px; padding: 9px 16px; font-size: 12.5px; font-family: var(--font-label); letter-spacing: .03em; gap: 7px; }
  .ditado-input { width: 100%; }
  .vocab-listen-secao { font-family: var(--font-label); font-size: 10.5px; letter-spacing: .04em; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: 999px; padding: 5px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin: 0 0 14px; transition: border-color .15s ease, color .15s ease; }
  .vocab-listen-secao:hover { border-color: var(--accent); color: var(--accent); }
  .bloco-audio { font-family: var(--font-label); font-size: 10.5px; letter-spacing: .04em; color: var(--accent); background: var(--accent-soft); border: 1px solid transparent; border-radius: 999px; padding: 5px 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin: 2px 0 14px; transition: border-color .15s ease, background .15s ease; }
  .bloco-audio:hover { border-color: var(--accent); }
  .bloco-audio.playing { background: var(--accent); color: var(--accent-text-on); }
  .vocab-cuidado { display: flex; gap: 7px; font-size: 12.5px; color: var(--text-muted); line-height: 1.5; }
  .vocab-cuidado span[aria-hidden] { flex: 0 0 auto; }

  .fluxo-lista { list-style: none; margin: 16px 0; padding: 0; counter-reset: fluxopasso; }
  .fluxo-lista li { counter-increment: fluxopasso; position: relative; padding: 0 0 20px 32px; font-size: 14px; line-height: 1.5; color: var(--text-muted); }
  .fluxo-lista li::before { content: counter(fluxopasso); position: absolute; left: 0; top: 0; width: 21px; height: 21px; border-radius: 50%; border: 1px solid var(--border); font-family: var(--font-label); font-size: 10px; color: var(--accent); display: flex; align-items: center; justify-content: center; }
  .fluxo-lista li::after { content: ""; position: absolute; left: 10px; top: 23px; bottom: 0; width: 1px; background: var(--border); }
  .fluxo-lista li:last-child { padding-bottom: 0; }
  .fluxo-lista li:last-child::after { display: none; }
  .fluxo-lista li.fluxo-decisao::before { border-color: var(--accent); background: var(--accent-soft); }

  .timeline { display: flex; flex-direction: column; gap: 0; margin: 16px 0; }
  .tl-item { position: relative; padding: 4px 0 22px 32px; }
  .tl-item::before { content: ""; position: absolute; left: 8px; top: 20px; bottom: -2px; width: 1px; background: var(--border); }
  .tl-item:last-child::before { display: none; }
  .tl-dot { position: absolute; left: 0; top: 2px; width: 17px; height: 17px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 9px; color: var(--bg); font-weight: 700; }
  .tl-title { font-family: var(--font-display); font-weight: 600; font-size: 14.5px; color: var(--text); margin-bottom: 4px; }
  .tl-desc { font-size: 13.5px; color: var(--text-muted); line-height: 1.6; }

  figure { margin: 14px 0; }
  .fig-wrap { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 12px; overflow-x: auto; }
  svg.diagram { width: 100%; height: auto; display: block; min-width: 300px; }
  figcaption { font-size: 12px; color: var(--text-muted); text-align: center; margin-top: 8px; line-height: 1.55; }

  .question { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-lg); padding: 16px; margin: 14px 0; }
  .q-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 9px; }
  .q-type { font-family: var(--font-label); font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; padding: 4px 10px; border-radius: 20px; background: var(--surface-2); color: var(--text-muted); }
  .q-text { font-size: 15px; font-weight: 500; color: var(--text); margin: 6px 0 11px 0; line-height: 1.55; }
  .q-scenario { background: var(--surface-2); border-left: 2px solid var(--amber); padding: 11px 13px; font-size: 14px; font-style: italic; color: var(--text-muted); margin-bottom: 11px; border-radius: var(--radius); }

  .confidence { display: flex; gap: 6px; align-items: center; font-size: 11.5px; color: var(--text-dim); margin-bottom: 11px; flex-wrap: wrap; }
  .confidence button { font-size: 10.5px; padding: 5px 10px; border-radius: 20px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; transition: all .15s ease; }
  .confidence button:hover { border-color: var(--accent); color: var(--text); }
  .confidence button.active { background: var(--accent); color: var(--accent-text-on); border-color: var(--accent); font-weight: 700; }
  .confidence button:active { transform: scale(.94); }

  .opt-btn { display: block; width: 100%; text-align: left; padding: 12px 13px; margin: 6px 0; border-radius: var(--radius); border: 1px solid var(--border-soft); background: var(--surface-2); font-size: 14px; cursor: pointer; color: var(--text); transition: border-color .15s ease, transform .12s ease; font-family: inherit; }
  .opt-btn:hover { border-color: var(--accent); transform: translateX(2px); }
  .opt-btn.correct { background: var(--accent-soft); border-color: var(--accent); font-weight: 600; color: var(--accent); }
  .opt-btn.incorrect { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }
  .opt-btn:disabled { cursor: default; transform: none; }

  .tf-row { display: flex; gap: 8px; margin: 8px 0; }
  .tf-btn { flex: 1; padding: 12px; border-radius: var(--radius); border: 1px solid var(--border-soft); background: var(--surface-2); font-size: 14px; font-weight: 600; cursor: pointer; color: var(--text); transition: border-color .15s ease; font-family: inherit; }
  .tf-btn:hover:not(:disabled) { border-color: var(--accent); }
  .tf-btn.correct { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .tf-btn.incorrect { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }
  .tf-btn:disabled { cursor: default; }

  textarea { width: 100%; min-height: 70px; border-radius: var(--radius); border: 1px solid var(--border); padding: 11px; font-size: 14px; font-family: inherit; resize: vertical; margin: 6px 0; background: var(--surface-2); color: var(--text); transition: border-color .15s ease; }
  textarea:focus { outline: none; border-color: var(--accent); }
  textarea::placeholder { color: var(--text-dim); }

  .classify-item { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border-soft); flex-wrap: wrap; }
  .classify-item:last-child { border-bottom: none; }
  .classify-label { font-size: 13.5px; flex: 1; min-width: 150px; color: var(--text); }
  .classify-btns { display: flex; gap: 6px; }
  .classify-btns button { font-size: 10.5px; padding: 7px 10px; border-radius: var(--radius); border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; transition: border-color .15s ease; font-family: inherit; }
  .classify-btns button:hover:not(:disabled) { border-color: var(--accent); }
  .classify-btns button.correct { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .classify-btns button.incorrect { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }

  .reveal-btn, .register-btn { margin-top: 8px; font-size: 13px; padding: 10px 16px; border-radius: var(--radius); border: none; background: var(--accent); color: var(--accent-text-on); cursor: pointer; font-weight: 700; transition: transform .12s ease, box-shadow .2s ease; animation: breathe 3s ease-in-out infinite; font-family: inherit; }
  .reveal-btn:hover, .register-btn:hover { transform: translateY(-1px); }
  .register-btn.done { background: var(--text-dim); color: var(--bg); animation: none; }
  @keyframes breathe { 0%, 100% { box-shadow: 0 0 0 0 var(--accent-soft); } 50% { box-shadow: 0 0 0 5px transparent; } }
  @media (prefers-reduced-motion: reduce) { .reveal-btn, .register-btn { animation: none; } }

  .explanation { display: none; margin-top: 10px; background: var(--accent-soft); border-left: 2px solid var(--accent); padding: 11px 13px; font-size: 13.5px; color: var(--text); border-radius: var(--radius); }
  .explanation.show { display: block; animation: slideIn .3s ease both; }

  .gate-hint { font-size: 12px; color: var(--amber); margin-top: 8px; display: none; }
  .gate-hint.show { display: block; }

  .navbar {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border-top: 1px solid var(--border-soft);
    padding: 11px 16px; display: flex; align-items: center; gap: 7px;
  }
  .nav-btn { flex: 1; padding: 12px; border-radius: var(--radius); border: none; font-size: 13px; font-weight: 600; cursor: pointer; letter-spacing: .3px; transition: transform .12s ease, filter .15s ease; font-family: inherit; }
  .nav-btn:active { transform: scale(.97); }
  .nav-prev { background: var(--surface-2); color: var(--text); border: 1px solid var(--border-soft); flex: 0 0 60px; }
  .nav-prev:hover:not(:disabled) { border-color: var(--border); }
  .nav-next { background: var(--accent); color: var(--accent-text-on); flex: 1; }
  .nav-next:hover:not(:disabled) { filter: brightness(1.08); }
  .nav-next:disabled { background: var(--surface-2); color: var(--text-dim); cursor: not-allowed; }
  .nav-audio { flex: 0 0 42px; background: var(--surface-2); border: 1px solid var(--border-soft); color: var(--text); border-radius: var(--radius); font-size: 14px; cursor: pointer; transition: border-color .15s ease; }
  .nav-audio:hover { border-color: var(--accent); }
  .nav-audio.speaking { background: var(--accent); color: var(--accent-text-on); border-color: var(--accent); }
  .nav-speed { flex: 0 0 46px; background: var(--surface-2); border: 1px solid var(--border-soft); color: var(--text); border-radius: var(--radius); font-size: 10.5px; font-weight: 700; cursor: pointer; transition: border-color .15s ease; font-family: inherit; }
  .nav-speed:hover { border-color: var(--accent); }
  .nav-speed:active { transform: scale(.94); }

  .anotacao-fab {
    position: fixed; right: 16px; bottom: 84px; z-index: 70;
    width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--surface);
    background: var(--accent); color: var(--accent-text-on); font-size: 19px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 6px rgba(0,0,0,.5), 0 6px 18px rgba(0,0,0,.4);
    transition: transform .12s ease, filter .15s ease;
  }
  .anotacao-fab:hover { filter: brightness(1.08); }
  .anotacao-fab:active { transform: scale(.94); }
  .anotacao-fab.tem-notas::after {
    content: ''; position: absolute; top: 2px; right: 2px; width: 10px; height: 10px;
    border-radius: 50%; background: var(--bad); border: 1.5px solid var(--accent);
  }
  .anotacao-painel {
    position: fixed; right: 16px; bottom: 138px; z-index: 70; width: min(340px, calc(100vw - 32px));
    max-height: min(420px, calc(100vh - 220px)); display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(0,0,0,.22); overflow: hidden;
  }
  .anotacao-painel[hidden] { display: none; }
  .anotacao-painel-tabs { display: flex; border-bottom: 1px solid var(--border-soft); flex: 0 0 auto; }
  .anotacao-tab { flex: 1; background: none; border: none; padding: 10px 8px; font-size: 12px; font-weight: 600; color: var(--text-dim); cursor: pointer; font-family: inherit; border-bottom: 2px solid transparent; }
  .anotacao-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .anotacao-aba { padding: 12px; overflow-y: auto; }
  .anotacao-texto { width: 100%; min-height: 90px; padding: 10px 12px; border-radius: var(--radius); border: 1px solid var(--border-soft); background: var(--surface-2); color: var(--text); font-family: inherit; font-size: 13px; resize: vertical; box-sizing: border-box; }
  .anotacao-salvar { display: inline-block; margin-top: 8px; padding: 8px 14px !important; font-size: 12.5px !important; }
  .anotacao-status { margin-left: 10px; font-size: 12px; color: var(--text-dim); }
  .anotacao-lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .anotacao-lista-vazio { font-size: 12.5px; color: var(--text-dim); }
  .anotacao-lista-item { text-align: left; width: 100%; background: var(--surface-2); border: 1px solid var(--border-soft); border-radius: var(--radius); padding: 8px 10px; cursor: pointer; font-family: inherit; color: var(--text); }
  .anotacao-lista-item:hover { border-color: var(--accent); }
  .anotacao-lista-item-slide { font-size: 10.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); font-weight: 700; }
  .anotacao-lista-item-texto { font-size: 12.5px; margin-top: 2px; color: var(--text-muted); white-space: pre-wrap; }

  .summary-box textarea { min-height: 220px; font-family: 'SF Mono', 'Courier New', monospace; font-size: 11.5px; }
  .copy-btn { background: var(--accent); color: var(--accent-text-on); border: none; padding: 11px 18px; border-radius: var(--radius); font-weight: 700; cursor: pointer; font-size: 13px; margin-top: 6px; transition: transform .12s ease; font-family: inherit; }
  .copy-btn:hover { transform: translateY(-1px); }
  .copy-btn.copied { background: var(--text-dim); }
  .stat-row { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--border-soft); font-size: 14px; color: var(--text-muted); }
  .stat-row:last-child { border-bottom: none; }
  .stat-val { font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }

  .veredito-chip { display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: 700; margin-bottom: 10px; }
  .veredito-chip.bom { background: var(--accent-soft); color: var(--accent); }
  .veredito-chip.aviso { background: color-mix(in srgb, var(--amber) 18%, transparent); color: var(--amber); }
  #avaliacaoResultado p { margin: 0 0 12px; font-size: 14px; }
  #avaliacaoAcoes { display: flex; flex-wrap: wrap; gap: 8px; }
  #avaliacaoErro p { margin: 0 0 10px; color: var(--bad); font-size: 13.5px; }
  #avaliacaoErro .register-btn, #avaliacaoErro .anotacao-toggle { margin-right: 8px; }
  .anotacao-toggle { background: none; border: 1px solid var(--border-soft); color: var(--text-dim); padding: 8px 14px; border-radius: var(--radius); font-size: 12.5px; cursor: pointer; font-family: inherit; }
  .anotacao-toggle:hover { border-color: var(--accent); color: var(--text); }

  svg { width: 100%; height: auto; display: block; }

  @media (min-width: 720px) {
    .slide { padding-left: clamp(20px, 5vw, 64px); padding-right: clamp(20px, 5vw, 64px); }
    .slide-inner { max-width: 860px; }
    h1.title { font-size: 29px; }
    h2.sub { font-size: 15.5px; }
    p, .q-text { font-size: 16px; }
    .box { padding: 18px 20px; }
  }
  @media (min-width: 1150px) {
    .slide-inner { max-width: 1040px; }
    h1.title { font-size: 34px; }
    h3.section-h { font-size: 17px; }
    p, .q-text { font-size: 16.5px; line-height: 1.7; }
    .box { padding: 20px 24px; font-size: 15.5px; }
    .question { padding: 22px; }
    .roadmap-item, .badge { font-size: 14.5px; }
  }
  @media (min-width: 1550px) {
    .slide-inner { max-width: 1220px; }
    h1.title { font-size: 38px; }
  }

  body.is-fullscreen .slide-inner { max-width: 1280px; }
  body.is-fullscreen h1.title { font-size: 40px; }
  body.is-fullscreen h3.section-h { font-size: 18px; }
  body.is-fullscreen .q-text, body.is-fullscreen p { font-size: 17.5px; }
  body.is-fullscreen .box { padding: 22px 26px; font-size: 16px; }

  {{ tema.extra_css | safe }}
  /* ---------------------------------------------------------------------------
     Impressão / "Baixar PDF" (texto corrido pro professor). Ativado pelo botão
     #pdfBtn (só aparece com ?pdf=1 na URL, que o emaus-web passa pra quem revisa).
     Força layout de artigo, troca pra paleta clara (tema escuro imprime péssimo)
     e tira tudo que é interação (navegação, checkpoints, avaliação, áudio).
  --------------------------------------------------------------------------- */
  .print-header { display: none; }

  @media print {
    @page { margin: 18mm 15mm; }

    :root {
      --bg: #ffffff; --surface: #ffffff; --surface-2: #f4f2ee;
      --border: #c9c4ba; --border-soft: #e3ded4;
      --text: #1c1a17; --text-muted: #4d4a44; --text-dim: #6f6b63;
      --accent: #8a5a1a; --accent-soft: #efe6d6; --accent-text-on: #ffffff;
      --bad: #9a3b2c; --bad-soft: #f2e4e0;
      --blue: #2f5566; --amber: #8a5a1a; --violet: #5a4a72;
    }

    html, body { background: #fff !important; color: #1c1a17 !important;
      height: auto !important; overflow: visible !important; }

    /* vira artigo: todos os slides visíveis, empilhados, sem animação */
    .slides { height: auto !important; overflow: visible !important; padding: 0 !important; background: #fff !important; }
    .slide { display: block !important; position: static !important; height: auto !important;
      overflow: visible !important; opacity: 1 !important; transform: none !important;
      animation: none !important; padding: 6px 0 14px !important; margin: 0 !important;
      border-bottom: 1px solid #ddd; }
    .slide:last-of-type { border-bottom: none; }
    .slide-inner { max-width: none !important; }

    /* fora: interação e navegação */
    .topbar, .navbar, .progress-track, .section-label,
    .gate-hint, .confidence, .badge-row, .anotacao-fab, .anotacao-painel,
    .vocab-listen, .vocab-listen-exemplo, .vocab-listen-secao,
    #pdfBtn, .modo-btn, .fullscreen-btn, .nav-audio,
    .slide[data-tipo="checkpoint"],
    .slide[data-tipo="avaliacao_intro"],
    .slide[data-tipo="avaliacao_pergunta"],
    .slide[data-tipo="resultado"],
    .slide[data-tipo="capa"] .box-instr {
      display: none !important;
    }

    .print-header { display: block !important; font-size: 9.5pt; color: #666;
      border-bottom: 1px solid #bbb; padding-bottom: 6px; margin-bottom: 16px;
      font-family: {{ tema.fontFamily }}; }

    /* composição de imagem some (sticky não existe em papel) */
    .conteudo-split, .conteudo-split.flip { display: block !important; }
    .conteudo-figura { position: static !important; margin-top: 10px !important; }
    img { max-width: 100% !important; max-height: 85mm !important; width: auto !important; height: auto !important; }

    /* não quebrar blocos no meio */
    .vocab-entry, .box, .cols2, figure, blockquote, .fluxo-lista li, .timeline .tl-item,
    .roadmap-item { break-inside: avoid; page-break-inside: avoid; }
    h1, h2, h3, .section-head, .section-h { break-after: avoid; page-break-after: avoid; }

    a { color: inherit; text-decoration: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; box-shadow: none !important; text-shadow: none !important; }
  }
</style>
</head>
<body>

<div class="print-header" aria-hidden="true">{{ content.titulo }} · Tópico {{ content.numero }}{% if content.aula %} · Aula {{ content.aula }}{% endif %}</div>

<div class="topbar">
  <div class="topbar-row">
    <span class="topbar-title">📖 Tópico {{ content.numero }} · {{ content.titulo }}</span>
    <span class="topbar-right">
      <button class="fullscreen-btn modo-btn" id="pdfBtn" title="Baixar PDF (texto corrido) — abre a caixa de impressão, escolha “Salvar como PDF”" hidden>📄 PDF</button>
      <button class="fullscreen-btn modo-btn" id="modoBtn" title="Alternar entre slide e corrido">☰ Corrido</button>
      {% if cores_dark_json %}
      <button class="fullscreen-btn modo-btn" id="temaBtn" title="Alternar entre claro e escuro">🌙 Escuro</button>
      {% endif %}
      <span class="topbar-count" id="slideCount">1/{{ content.slides|length }}</span>
      <button class="fullscreen-btn" id="fullscreenBtn" title="Tela cheia">⛶</button>
    </span>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
  <div class="section-label" id="sectionLabel">Conteúdo</div>
</div>

<div class="slides" id="slides">
{% set ns = namespace(secao_idx=0) %}
{% for slide in content.slides %}
  <div class="slide{% if loop.first %} active{% endif %}" data-section="{{ slide.secao }}" data-tipo="{{ slide.tipo }}"{% if slide.gate_id %} data-gate="{{ slide.gate_id }}"{% endif %}>
    <div class="slide-inner"{% if slide.narracao %} data-narracao='{{ slide.narracao | tojson }}'{% endif %}>

      {% if slide.tipo == 'capa' %}
        <h1 class="title">{{ slide.titulo }}</h1>
        <h2 class="sub">{{ slide.subtitulo }}</h2>
        {% if content.imagem_capa %}
        <img class="capa-imagem" src="{{ content.imagem_capa.url }}" alt="{{ content.imagem_capa.alt or slide.titulo }}">
        {% endif %}
        {% if slide.instrucoes_box %}
        <div class="box box-instr">
          <div class="box-label">{{ slide.instrucoes_box.label }}</div>
          {{ slide.instrucoes_box.texto }}
        </div>
        {% endif %}
        <h3 class="section-h">Roteiro deste tópico</h3>
        <div class="roadmap">
          {% for item in content.roteiro %}
          <div class="roadmap-item"><span class="roadmap-num">{{ loop.index }}</span> {{ item }}</div>
          {% endfor %}
        </div>
        <div class="badge-row">
          {% for b in content.badges_capa %}<span class="badge">{{ b }}</span>
          {% endfor %}
        </div>

      {% elif slide.tipo == 'conteudo' %}
        {% set ns.secao_idx = ns.secao_idx + 1 %}
        {% if slide.titulo_secao %}
          {% if tema.numeracaoEstilo and tema.numeracaoEstilo != 'nenhum' %}
          <div class="section-head numerado">
            <span class="section-numero">{{ tema.rotuloSecao | default('Seção') }} {{ ns.secao_idx | romano if tema.numeracaoEstilo == 'romano' else ns.secao_idx }}</span>
            <h3 class="section-h">{{ slide.titulo_secao }}</h3>
          </div>
          {% else %}
          <h3 class="section-h">{{ slide.titulo_secao }}</h3>
          {% endif %}
        {% endif %}
        {% set vocabs_secao = slide.blocos | selectattr('tipo', 'equalto', 'vocab') | list %}
        {% if vocabs_secao | length > 0 %}
        <button type="button" class="vocab-listen-secao">🔊 Ouvir vocabulário desta seção</button>
        {% endif %}
        {% set imagens = slide.blocos | selectattr('tipo', 'equalto', 'imagem_sugerida') | list %}
        {% if imagens | length == 1 %}
          {% set outros = slide.blocos | rejectattr('tipo', 'equalto', 'imagem_sugerida') | list %}
          <div class="conteudo-split{% if ns.secao_idx is even %} flip{% endif %}">
            <div class="conteudo-texto">
              {% for bloco in outros %}{{ render_bloco(bloco) }}{% endfor %}
            </div>
            <div class="conteudo-figura">{{ render_bloco(imagens[0]) }}</div>
          </div>
        {% else %}
          {% for bloco in slide.blocos %}{{ render_bloco(bloco) }}{% endfor %}
        {% endif %}

      {% elif slide.tipo == 'checkpoint' %}
        <h3 class="section-h">{{ slide.titulo_secao }}</h3>
        {% for pergunta in slide.perguntas %}{{ render_pergunta(pergunta) }}{% endfor %}
        <div class="gate-hint" data-gate-hint="{{ slide.gate_id }}">👆 Responda antes de continuar.</div>

      {% elif slide.tipo == 'avaliacao_intro' %}
        <h1 class="title">{{ slide.titulo }}</h1>
        <h2 class="sub">{{ slide.subtitulo }}</h2>
        {% if slide.instrucoes_box %}
        <div class="box box-instr">
          <div class="box-label">{{ slide.instrucoes_box.label }}</div>
          {{ slide.instrucoes_box.texto }}
        </div>
        {% endif %}

      {% elif slide.tipo == 'avaliacao_pergunta' %}
        {{ render_pergunta(slide.pergunta) }}
        <div class="gate-hint" data-gate-hint="{{ slide.gate_id }}">👆 Responda antes de continuar.</div>

      {% elif slide.tipo == 'resultado' %}
        <h1 class="title">{{ slide.titulo }}</h1>
        <div class="box box-summary" id="statsBox">
          <div class="box-label">📊 Pontuação objetiva</div>
          <div class="stat-row"><span>Acertos automáticos</span><span class="stat-val" id="statScore">0 / 0</span></div>
          <div class="stat-row"><span>Respostas com alta confiança e erro</span><span class="stat-val" id="statFlags">0</span></div>
          <div class="stat-row"><span>Questões abertas registradas</span><span class="stat-val" id="statOpen">0 / {{ open_total }}</span></div>
        </div>
        <div class="box box-instr" id="instrPadraoBox">
          <div class="box-label">➡ Próximo passo</div>
          A correção automática não avalia as respostas abertas nem decide se você já domina o tópico — isso fica pra uma leitura de verdade, feita por mim no chat. Copie o resumo abaixo e cole na conversa com o Claude Code.
        </div>
        <div class="box summary-box" id="resumoPadraoBox">
          <div class="box-label">📄 Resumo para colar no chat</div>
          <textarea id="summaryText" readonly></textarea>
          <button class="copy-btn" id="copyBtn">Copiar resumo</button>
        </div>
        <div class="box box-instr" id="resumoEmbutidoBox" hidden>
          <div id="avaliacaoPendente">
            <div class="box-label">➡ Próximo passo</div>
            Clique em <strong>“Fim”</strong>, embaixo, pra enviar sua avaliação.
          </div>
          <div id="avaliacaoCarregando" hidden>Avaliando seu estudo…</div>
          <div id="avaliacaoErro" hidden>
            <p id="avaliacaoErroMsg"></p>
            <button type="button" class="register-btn" id="avaliacaoTentarDeNovo">Tentar de novo</button>
            <button type="button" class="anotacao-toggle" id="avaliacaoConcluirMesmoAssim">Marcar como concluído mesmo assim</button>
          </div>
          <div id="avaliacaoResultado" hidden>
            <div class="veredito-chip" id="veredictoChip"></div>
            <p id="resumoDiagnostico"></p>
            <div id="avaliacaoAcoes"></div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
{% endfor %}
</div>

<button type="button" class="anotacao-fab" id="anotacaoFab" title="Anotações" aria-label="Anotações">✍️</button>
<div class="anotacao-painel" id="anotacaoPainel" hidden>
  <div class="anotacao-painel-tabs">
    <button type="button" class="anotacao-tab active" data-aba="anotar">Anotar este slide</button>
    <button type="button" class="anotacao-tab" data-aba="ver">Minhas anotações</button>
  </div>
  <div class="anotacao-aba" data-aba-conteudo="anotar">
    <textarea class="anotacao-texto" id="anotacaoTextoAtual" placeholder="Sua anotação sobre este slide..."></textarea>
    <button type="button" class="anotacao-salvar register-btn" id="anotacaoSalvarBtn">Salvar anotação</button>
    <span class="anotacao-status" id="anotacaoStatus"></span>
  </div>
  <div class="anotacao-aba" data-aba-conteudo="ver" hidden>
    <ul class="anotacao-lista" id="anotacaoLista"></ul>
  </div>
</div>

<div class="navbar">
  <button class="nav-btn nav-prev" id="prevBtn">◀</button>
  <button class="nav-audio" id="audioBtn" title="Ouvir este slide">🔊</button>
  <button class="nav-speed" id="speedBtn" title="Velocidade do áudio (leitura do slide e 🔊 de vocabulário)">1x</button>
  <button class="nav-btn nav-next" id="nextBtn">Próximo ▶</button>
</div>

<script>
const TOPICO_ID = {{ content.topico_id|tojson }};
const TOPICO_TITULO = {{ content.titulo|tojson }};
const TOPICO_NUMERO = {{ content.numero }};
const PROXIMO_TOPICO_LABEL = {{ (content.slides|selectattr("tipo","equalto","resultado")|first).proximo_topico_label|tojson }};
const QUESTION_ORDER = {{ question_order_json | safe }};
const OPEN_TOTAL = {{ open_total }};

// Estado inicial da avaliação do tutor, passado pelo Emaús via querystring
// (2026-09-11) — permite reabrir um tópico já concluído e ver o resultado
// final direto no slide "Resultado", sem precisar clicar em "Fim" de novo.
const AVALIACAO_INICIAL = (function () {
  var p = new URLSearchParams(window.location.search);
  return {
    concluido: p.get('concluido') === '1',
    veredito: p.get('veredito') || null,
    resumo: p.get('resumo') || '',
    temProximo: p.get('proximo') === '1',
  };
})();

const state = {};
function ensureQ(qid) {
  if (!state[qid]) state[qid] = { confidence: null, correct: null, text: null };
  return state[qid];
}

// Salvar/restaurar resposta por exercício (2026-09-09). Token de escopo curto
// (?token=... na URL, emitido por POST /auth/topico-token — NÃO é o token de
// sessão real, que nunca sai do servidor Next.js) + o Topico.id de verdade
// (extraído do próprio path /topicos/{id}/render, já que TOPICO_ID acima é a
// string de conteúdo, não a chave do banco). Desligado na tela de revisão
// (?contexto=revisao) de propósito — testar exercício ali não deve sujar
// progresso real do aluno.
const RESPOSTAS_TOPICO_ID_DB = (function () {
  var m = window.location.pathname.match(/\/topicos\/(\d+)\/render/);
  return m ? parseInt(m[1], 10) : null;
})();
const RESPOSTAS_TOKEN = new URLSearchParams(window.location.search).get('token');
const RESPOSTAS_CONTEXTO_REVISAO = new URLSearchParams(window.location.search).get('contexto') === 'revisao';
const RESPOSTAS_ATIVO = !!(RESPOSTAS_TOPICO_ID_DB && RESPOSTAS_TOKEN) && !RESPOSTAS_CONTEXTO_REVISAO;

function salvarRespostaRemota(qid, gateId, tipo, respostaDada, correta) {
  if (!RESPOSTAS_ATIVO) return;
  fetch(window.location.origin + '/topico-respostas/' + RESPOSTAS_TOPICO_ID_DB + '/' + encodeURIComponent(qid), {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
    body: JSON.stringify({ gate_id: gateId, tipo: tipo, resposta_dada: respostaDada, correta: correta }),
  }).catch(function (e) { console.error('falha ao salvar resposta', qid, e); });
}

// Slide exato onde o aluno parou (2026-09-15) — mesmo token/mesma regra de
// RESPOSTAS_ATIVO das respostas de exercício acima. Fire-and-forget: se falhar,
// só não restaura o lugar certo na próxima abertura, nada quebra na hora.
function salvarSlideRemoto(idx) {
  if (!RESPOSTAS_ATIVO) return;
  fetch(window.location.origin + '/topico-progress/' + RESPOSTAS_TOPICO_ID_DB + '/slide', {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
    body: JSON.stringify({ indice: idx }),
  }).catch(function (e) { console.error('falha ao salvar slide atual', e); });
}

// Este render roda dentro de um <iframe> no Emaús (emaus-web/app/topico) ou
// sozinho (aba própria, uso pessoal). Vários comportamentos abaixo (botão
// "Fim" concluir, caixa de copiar resumo, anotação) mudam conforme isso.
const EMBUTIDO = !!(window.parent && window.parent !== window);
if (EMBUTIDO) {
  var instrPadrao = document.getElementById('instrPadraoBox');
  var resumoPadrao = document.getElementById('resumoPadraoBox');
  var resumoEmbutido = document.getElementById('resumoEmbutidoBox');
  if (instrPadrao) instrPadrao.hidden = true;
  if (resumoPadrao) resumoPadrao.hidden = true;
  if (resumoEmbutido) resumoEmbutido.hidden = false;
}

// Avaliação do tutor, renderizada como parte do próprio slide "Resultado"
// (2026-09-11) — antes disso o veredito aparecia num painel fixo FORA do
// <iframe>, no Emaús. O <iframe> não tem o token de sessão real (fica só no
// servidor Next.js — ver docstring de topico_respostas.py), então quem
// chama o Tutor continua sendo o pai; aqui só troca as caixas de estado e
// devolve o resultado pra dentro do slide.
var ultimoResumoEnviado = null;

function mostrarEstadoAvaliacao(estado) {
  ['avaliacaoPendente', 'avaliacaoCarregando', 'avaliacaoErro', 'avaliacaoResultado'].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.hidden = (id !== estado);
  });
}

function renderizarResultadoAvaliacao(veredito, resumo, temProximo) {
  var dominado = veredito === 'dominado';
  var chip = document.getElementById('veredictoChip');
  chip.textContent = dominado ? '✓ Você passou' : 'Precisa reforçar antes de seguir';
  chip.className = 'veredito-chip ' + (dominado ? 'bom' : 'aviso');
  document.getElementById('resumoDiagnostico').textContent = resumo || '';

  var acoes = document.getElementById('avaliacaoAcoes');
  acoes.innerHTML = '';
  if (dominado) {
    var btnProximo = document.createElement('button');
    btnProximo.type = 'button';
    btnProximo.className = 'copy-btn';
    btnProximo.textContent = temProximo ? 'Próximo tópico ▶' : 'Voltar ao curso';
    btnProximo.addEventListener('click', function () {
      try { window.parent.postMessage({ tipo: 'emaus:navegar', destino: temProximo ? 'proximo' : 'curso' }, '*'); } catch (e) {}
    });
    acoes.appendChild(btnProximo);
  } else {
    var btnRefazer = document.createElement('button');
    btnRefazer.type = 'button';
    btnRefazer.className = 'anotacao-toggle';
    btnRefazer.textContent = 'Refazer o estudo';
    btnRefazer.addEventListener('click', function () { window.location.reload(); });
    acoes.appendChild(btnRefazer);
  }
  mostrarEstadoAvaliacao('avaliacaoResultado');
}

if (EMBUTIDO && AVALIACAO_INICIAL.concluido && AVALIACAO_INICIAL.veredito) {
  renderizarResultadoAvaliacao(AVALIACAO_INICIAL.veredito, AVALIACAO_INICIAL.resumo, AVALIACAO_INICIAL.temProximo);
}

document.getElementById('avaliacaoTentarDeNovo') && document.getElementById('avaliacaoTentarDeNovo').addEventListener('click', function () {
  if (!ultimoResumoEnviado) return;
  mostrarEstadoAvaliacao('avaliacaoCarregando');
  try { window.parent.postMessage({ tipo: 'emaus:concluir', texto: ultimoResumoEnviado }, '*'); } catch (e) {}
});

document.getElementById('avaliacaoConcluirMesmoAssim') && document.getElementById('avaliacaoConcluirMesmoAssim').addEventListener('click', function (e) {
  try { window.parent.postMessage({ tipo: 'emaus:concluir-fallback' }, '*'); } catch (err) {}
  e.target.disabled = true;
  e.target.textContent = 'Marcado ✔';
});

// Anotação pessoal do aluno por slide (2026-09-10, virou botão flutuante em
// 2026-09-11 — antes era um toggle por slide + painel fixo fora do <iframe>
// no Emaús; agora tudo mora aqui dentro, um botão só). Mesmo token de escopo
// curto das respostas de exercício (RESPOSTAS_TOKEN acima), endpoint
// diferente (/topico-anotacoes). Some da tela de revisão do professor de
// propósito — ali quem anota é o TopicoComment (FASE 5a), ferramenta
// diferente desta.
var anotacoesPorSlide = {};
var anotacaoFab = document.getElementById('anotacaoFab');
var anotacaoPainel = document.getElementById('anotacaoPainel');
var anotacaoTextoAtual = document.getElementById('anotacaoTextoAtual');
var anotacaoStatus = document.getElementById('anotacaoStatus');
var anotacaoLista = document.getElementById('anotacaoLista');

if (RESPOSTAS_CONTEXTO_REVISAO) {
  anotacaoFab.hidden = true;
} else {
  function slideIndexAtual() { return current; }

  function atualizarTextoAnotacaoAtual() {
    anotacaoTextoAtual.value = anotacoesPorSlide[slideIndexAtual()] || '';
    anotacaoStatus.textContent = '';
  }

  function atualizarFabIndicador() {
    var temAlguma = Object.keys(anotacoesPorSlide).some(function (k) { return anotacoesPorSlide[k]; });
    anotacaoFab.classList.toggle('tem-notas', temAlguma);
  }

  function renderizarListaAnotacoes() {
    var indices = Object.keys(anotacoesPorSlide)
      .map(function (k) { return parseInt(k, 10); })
      .filter(function (i) { return anotacoesPorSlide[i]; })
      .sort(function (a, b) { return a - b; });

    if (!indices.length) {
      anotacaoLista.innerHTML = '<li class="anotacao-lista-vazio">Nenhuma anotação ainda.</li>';
      return;
    }
    anotacaoLista.innerHTML = '';
    indices.forEach(function (idx) {
      var li = document.createElement('li');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'anotacao-lista-item';
      var rotuloSlide = document.createElement('div');
      rotuloSlide.className = 'anotacao-lista-item-slide';
      rotuloSlide.textContent = 'Slide ' + (idx + 1);
      var textoEl = document.createElement('div');
      textoEl.className = 'anotacao-lista-item-texto';
      textoEl.textContent = anotacoesPorSlide[idx];
      btn.appendChild(rotuloSlide);
      btn.appendChild(textoEl);
      btn.addEventListener('click', function () {
        showSlide(idx);
        trocarAbaAnotacao('anotar');
      });
      li.appendChild(btn);
      anotacaoLista.appendChild(li);
    });
  }

  function trocarAbaAnotacao(aba) {
    document.querySelectorAll('.anotacao-tab').forEach(function (t) {
      t.classList.toggle('active', t.dataset.aba === aba);
    });
    document.querySelectorAll('.anotacao-aba').forEach(function (a) {
      a.hidden = a.dataset.abaConteudo !== aba;
    });
    if (aba === 'anotar') atualizarTextoAnotacaoAtual();
    else renderizarListaAnotacoes();
  }

  anotacaoFab.addEventListener('click', function () {
    anotacaoPainel.hidden = !anotacaoPainel.hidden;
    if (!anotacaoPainel.hidden) trocarAbaAnotacao('anotar');
  });

  document.querySelectorAll('.anotacao-tab').forEach(function (tab) {
    tab.addEventListener('click', function () { trocarAbaAnotacao(tab.dataset.aba); });
  });

  document.getElementById('anotacaoSalvarBtn').addEventListener('click', function () {
    var idx = slideIndexAtual();
    var texto = anotacaoTextoAtual.value.trim();
    if (!RESPOSTAS_ATIVO) { anotacaoStatus.textContent = 'Faça login pra salvar.'; return; }
    anotacaoStatus.textContent = 'Salvando…';
    fetch(window.location.origin + '/topico-anotacoes/' + RESPOSTAS_TOPICO_ID_DB + '/' + idx, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
      body: JSON.stringify({ texto: texto }),
    })
      .then(function (r) { if (!r.ok) throw new Error('status ' + r.status); return r.json(); })
      .then(function () {
        anotacoesPorSlide[idx] = texto || null;
        atualizarFabIndicador();
        anotacaoStatus.textContent = 'Salvo ✔';
        setTimeout(function () { anotacaoStatus.textContent = ''; }, 2000);
      })
      .catch(function (e) { anotacaoStatus.textContent = 'Erro ao salvar — tenta de novo.'; console.error('falha ao salvar anotação', e); });
  });

  if (RESPOSTAS_ATIVO) {
    fetch(window.location.origin + '/topico-anotacoes/' + RESPOSTAS_TOPICO_ID_DB, {
      headers: { 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
    })
      .then(function (r) { return r.ok ? r.json() : []; })
      .then(function (lista) {
        lista.forEach(function (a) { if (a.texto) anotacoesPorSlide[a.slide_index] = a.texto; });
        atualizarFabIndicador();
      })
      .catch(function (e) { console.error('falha ao carregar anotações', e); });
  }
}

// Fila de revisão do professor manda ir pra um slide específico ao clicar
// num comentário existente — reaproveitado aqui pro painel "Minhas
// anotações" também. Além disso, é aqui que o pai (Emaús) devolve o
// resultado da avaliação do tutor pro slide "Resultado" (ver
// renderizarResultadoAvaliacao acima) — o <iframe> pediu com 'emaus:concluir',
// o pai chamou a API (só ele tem o token de sessão real) e manda a resposta
// de volta pra cá.
window.addEventListener('message', function (e) {
  var d = e.data;
  if (!d) return;
  if (d.tipo === 'emaus:ir-slide' && typeof d.indice === 'number') {
    showSlide(d.indice);
  } else if (d.tipo === 'emaus:avaliacao-resultado') {
    renderizarResultadoAvaliacao(d.veredito, d.resumo_diagnostico, !!d.temProximo);
  } else if (d.tipo === 'emaus:avaliacao-erro') {
    document.getElementById('avaliacaoErroMsg').textContent = d.mensagem || 'Não deu pra falar com o tutor agora.';
    mostrarEstadoAvaliacao('avaliacaoErro');
  }
});

document.querySelectorAll('.confidence').forEach(function (box) {
  const qid = box.dataset.confidence;
  box.querySelectorAll('button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      box.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      ensureQ(qid).confidence = btn.dataset.c;
    });
  });
});

document.querySelectorAll('.opts').forEach(function (optsEl) {
  const qid = optsEl.dataset.qid;
  const correctIdx = parseInt(optsEl.dataset.correct, 10);
  const question = optsEl.closest('.question');
  const exp = question.querySelector('.explanation');
  const buttons = optsEl.querySelectorAll('.opt-btn');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (optsEl.dataset.answered) return;
      optsEl.dataset.answered = '1';
      const chosenIdx = parseInt(btn.dataset.i, 10);
      buttons.forEach(function (b) { b.disabled = true; });
      buttons[correctIdx].classList.add('correct');
      const isCorrect = chosenIdx === correctIdx;
      if (!isCorrect) btn.classList.add('incorrect');
      ensureQ(qid).correct = isCorrect;
      if (exp) exp.classList.add('show');
      salvarRespostaRemota(qid, optsEl.closest('.slide').dataset.gate, 'mc', chosenIdx, isCorrect);
      checkGate(optsEl.closest('.slide'));
      updateStatsLive();
    });
  });
});

document.querySelectorAll('.tf-row').forEach(function (row) {
  const qid = row.dataset.qid;
  const correctVal = row.dataset.correctTf;
  const question = row.closest('.question');
  const exp = question.querySelector('.explanation');
  const buttons = row.querySelectorAll('.tf-btn');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (row.dataset.answered) return;
      row.dataset.answered = '1';
      buttons.forEach(function (b) { b.disabled = true; });
      const correctBtn = row.querySelector('[data-v="' + correctVal + '"]');
      correctBtn.classList.add('correct');
      const isCorrect = btn.dataset.v === correctVal;
      if (!isCorrect) btn.classList.add('incorrect');
      ensureQ(qid).correct = isCorrect;
      if (exp) exp.classList.add('show');
      salvarRespostaRemota(qid, row.closest('.slide').dataset.gate, 'tf', btn.dataset.v, isCorrect);
      checkGate(row.closest('.slide'));
      updateStatsLive();
    });
  });
});

document.querySelectorAll('[data-gate-group]').forEach(function (group) {
  const groupId = group.dataset.gateGroup;
  const groupTipo = group.dataset.tipo === 'associar' ? 'associar' : 'classify';
  group.querySelectorAll('.classify-item').forEach(function (item) {
    const qid = item.dataset.qid;
    const correctVal = item.dataset.correct;
    const buttons = item.querySelectorAll('.classify-btns button');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (item.dataset.answered) return;
        item.dataset.answered = '1';
        buttons.forEach(function (b) { b.disabled = true; });
        const correctBtn = item.querySelector('[data-v="' + correctVal + '"]');
        if (correctBtn) correctBtn.classList.add('correct');
        const isCorrect = btn.dataset.v === correctVal;
        if (!isCorrect) btn.classList.add('incorrect');
        ensureQ(qid).correct = isCorrect;
        const allAnswered = group.querySelectorAll('.classify-item:not([data-answered])').length === 0;
        if (allAnswered) {
          const exp = document.querySelector('[data-exp="' + groupId + '"]');
          if (exp) exp.classList.add('show');
        }
        salvarRespostaRemota(qid, item.closest('.slide').dataset.gate, groupTipo, btn.dataset.v, isCorrect);
        checkGate(item.closest('.slide'));
        updateStatsLive();
      });
    });
  });
});

document.querySelectorAll('.reveal-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    const target = document.querySelector('[data-exp="' + btn.dataset.target + '"]');
    if (target) target.classList.add('show');
  });
});

function normalizarResposta(s) {
  return (s || '').trim().toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
}
document.querySelectorAll('.lacuna-wrap').forEach(function (wrap) {
  const qid = wrap.dataset.qid;
  const aceitas = JSON.parse(wrap.dataset.answers || '[]').map(normalizarResposta);
  const input = wrap.querySelector('.lacuna-input');
  const btn = wrap.querySelector('.lacuna-check-btn');
  const question = wrap.closest('.question');
  const exp = question.querySelector('.explanation');
  btn.addEventListener('click', function () {
    if (wrap.dataset.answered) return;
    const valor = input.value.trim();
    if (!valor) { input.focus(); return; }
    const isCorrect = aceitas.indexOf(normalizarResposta(valor)) !== -1;
    wrap.dataset.answered = '1';
    input.disabled = true;
    btn.disabled = true;
    btn.classList.add('done');
    input.style.borderColor = isCorrect ? 'var(--accent)' : 'var(--bad)';
    ensureQ(qid).correct = isCorrect;
    if (exp) exp.classList.add('show');
    salvarRespostaRemota(qid, wrap.closest('.slide').dataset.gate, 'lacuna', valor, isCorrect);
    checkGate(wrap.closest('.slide'));
    updateStatsLive();
  });
});

// Ditado: mesma correção por string do lacuna-wrap (normalizarResposta já definida acima);
// o botão de tocar áudio (.ditado-play) usa a classe .vocab-listen, então já é pego pelo
// listener de vocabulário mais abaixo — não precisa de handler de áudio separado aqui.
document.querySelectorAll('.ditado-wrap').forEach(function (wrap) {
  const qid = wrap.dataset.qid;
  const aceitas = JSON.parse(wrap.dataset.answers || '[]').map(normalizarResposta);
  const input = wrap.querySelector('.ditado-input');
  const btn = wrap.querySelector('.ditado-check-btn');
  const question = wrap.closest('.question');
  const exp = question.querySelector('.explanation');
  btn.addEventListener('click', function () {
    if (wrap.dataset.answered) return;
    const valor = input.value.trim();
    if (!valor) { input.focus(); return; }
    const isCorrect = aceitas.indexOf(normalizarResposta(valor)) !== -1;
    wrap.dataset.answered = '1';
    input.disabled = true;
    btn.disabled = true;
    btn.classList.add('done');
    input.style.borderColor = isCorrect ? 'var(--accent)' : 'var(--bad)';
    ensureQ(qid).correct = isCorrect;
    salvarRespostaRemota(qid, wrap.closest('.slide').dataset.gate, 'ditado', valor, isCorrect);
    if (exp) exp.classList.add('show');
    checkGate(wrap.closest('.slide'));
    updateStatsLive();
  });
});

// Restaurar respostas salvas (2026-09-09) — reaplica o mesmo estado visual que
// cada handler acima aplicaria, sem disparar salvarRespostaRemota() de novo
// (senão viraria um loop de re-salvar o que acabou de ser lido).
function restaurarMC(qid, escolhaSalva) {
  const optsEl = document.querySelector('.opts[data-qid="' + qid + '"]');
  if (!optsEl || optsEl.dataset.answered) return;
  const correctIdx = parseInt(optsEl.dataset.correct, 10);
  const buttons = optsEl.querySelectorAll('.opt-btn');
  optsEl.dataset.answered = '1';
  buttons.forEach(function (b) { b.disabled = true; });
  if (buttons[correctIdx]) buttons[correctIdx].classList.add('correct');
  if (escolhaSalva !== correctIdx && buttons[escolhaSalva]) buttons[escolhaSalva].classList.add('incorrect');
  ensureQ(qid).correct = escolhaSalva === correctIdx;
  const exp = optsEl.closest('.question').querySelector('.explanation');
  if (exp) exp.classList.add('show');
}
function restaurarTF(qid, escolhaSalva) {
  const row = document.querySelector('.tf-row[data-qid="' + qid + '"]');
  if (!row || row.dataset.answered) return;
  const correctVal = row.dataset.correctTf;
  const buttons = row.querySelectorAll('.tf-btn');
  row.dataset.answered = '1';
  buttons.forEach(function (b) { b.disabled = true; });
  const correctBtn = row.querySelector('[data-v="' + correctVal + '"]');
  if (correctBtn) correctBtn.classList.add('correct');
  if (escolhaSalva !== correctVal) {
    const chosenBtn = row.querySelector('[data-v="' + escolhaSalva + '"]');
    if (chosenBtn) chosenBtn.classList.add('incorrect');
  }
  ensureQ(qid).correct = escolhaSalva === correctVal;
  const exp = row.closest('.question').querySelector('.explanation');
  if (exp) exp.classList.add('show');
}
function restaurarClassify(qid, escolhaSalva) {
  const item = document.querySelector('.classify-item[data-qid="' + qid + '"]');
  if (!item || item.dataset.answered) return;
  const correctVal = item.dataset.correct;
  const buttons = item.querySelectorAll('.classify-btns button');
  item.dataset.answered = '1';
  buttons.forEach(function (b) { b.disabled = true; });
  const correctBtn = item.querySelector('[data-v="' + correctVal + '"]');
  if (correctBtn) correctBtn.classList.add('correct');
  if (escolhaSalva !== correctVal) {
    const chosenBtn = item.querySelector('[data-v="' + escolhaSalva + '"]');
    if (chosenBtn) chosenBtn.classList.add('incorrect');
  }
  ensureQ(qid).correct = escolhaSalva === correctVal;
  const group = item.closest('[data-gate-group]');
  if (group) {
    const allAnswered = group.querySelectorAll('.classify-item:not([data-answered])').length === 0;
    if (allAnswered) {
      const exp = document.querySelector('[data-exp="' + group.dataset.gateGroup + '"]');
      if (exp) exp.classList.add('show');
    }
  }
}
function restaurarLacunaOuDitado(qid, valorSalvo, seletorWrap, seletorInput, seletorBtn) {
  const wrap = document.querySelector(seletorWrap + '[data-qid="' + qid + '"]');
  if (!wrap || wrap.dataset.answered) return;
  const input = wrap.querySelector(seletorInput);
  const btn = wrap.querySelector(seletorBtn);
  const aceitas = JSON.parse(wrap.dataset.answers || '[]').map(normalizarResposta);
  const isCorrect = aceitas.indexOf(normalizarResposta(valorSalvo)) !== -1;
  wrap.dataset.answered = '1';
  input.value = valorSalvo;
  input.disabled = true;
  btn.disabled = true;
  btn.classList.add('done');
  input.style.borderColor = isCorrect ? 'var(--accent)' : 'var(--bad)';
  ensureQ(qid).correct = isCorrect;
  const exp = wrap.closest('.question').querySelector('.explanation');
  if (exp) exp.classList.add('show');
}
function restaurarOpen(qid, textoSalvo) {
  const textarea = document.querySelector('textarea[data-open="' + qid + '"]');
  const btn = document.querySelector('.register-btn[data-register="' + qid + '"]');
  if (!textarea || !btn || btn.dataset.answered) return;
  textarea.value = textoSalvo;
  ensureQ(qid).text = textoSalvo;
  btn.textContent = 'Registrado ✔ (clique de novo se editar)';
  btn.classList.add('done');
  btn.dataset.answered = '1';
}

if (RESPOSTAS_ATIVO) {
  fetch(window.location.origin + '/topico-respostas/' + RESPOSTAS_TOPICO_ID_DB, {
    headers: { 'Authorization': 'Bearer ' + RESPOSTAS_TOKEN },
  })
    .then(function (r) { return r.ok ? r.json() : []; })
    .then(function (respostas) {
      respostas.forEach(function (r) {
        switch (r.tipo) {
          case 'mc': restaurarMC(r.question_id, r.resposta_dada); break;
          case 'tf': restaurarTF(r.question_id, r.resposta_dada); break;
          case 'classify':
          case 'associar': restaurarClassify(r.question_id, r.resposta_dada); break;
          case 'lacuna': restaurarLacunaOuDitado(r.question_id, r.resposta_dada, '.lacuna-wrap', '.lacuna-input', '.lacuna-check-btn'); break;
          case 'ditado': restaurarLacunaOuDitado(r.question_id, r.resposta_dada, '.ditado-wrap', '.ditado-input', '.ditado-check-btn'); break;
          case 'open': restaurarOpen(r.question_id, r.resposta_dada); break;
        }
      });
      document.querySelectorAll('.slide[data-gate]').forEach(function (el) { checkGate(el); });
      updateStatsLive();
    })
    .catch(function (e) { console.error('falha ao carregar respostas salvas', e); });
}

// Velocidade dos 🔊 de vocabulário: mesma preferência do botão de leitura
// (#speedBtn / gcTtsSpeedIdx). Pronúncia de palavra isolada pede um pouco
// mais devagar que a leitura corrida, então aplica um leve desconto.
function taxaAudioVocab() {
  try {
    var lv = [0.65, 0.8, 1.0, 1.2, 1.4];
    var idx = parseInt(localStorage.getItem('gcTtsSpeedIdx'), 10);
    if (isNaN(idx) || idx < 0 || idx >= lv.length) idx = 2;
    return Math.max(0.5, lv[idx] * 0.9);
  } catch (e) { return 0.9; }
}

document.querySelectorAll('.vocab-listen').forEach(function (btn) {
  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(btn.dataset.say);
    utter.lang = 'en-US';
    utter.rate = taxaAudioVocab();
    window.speechSynthesis.speak(utter);
  });
});

document.querySelectorAll('.vocab-listen-secao').forEach(function (btn) {
  btn.addEventListener('click', function () {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();
    var slideEl = btn.closest('.slide');
    var fila = [];
    slideEl.querySelectorAll('.vocab-entry').forEach(function (entry) {
      var termoBtn = entry.querySelector('.vocab-listen');
      var exemploBtn = entry.querySelector('.vocab-listen-exemplo');
      if (termoBtn) fila.push(termoBtn.dataset.say);
      if (exemploBtn) fila.push(exemploBtn.dataset.say);
    });
    var i = 0;
    function proxima() {
      if (i >= fila.length) return;
      var utter = new SpeechSynthesisUtterance(fila[i]);
      utter.lang = 'en-US';
      utter.rate = taxaAudioVocab();
      utter.onend = function () { i++; proxima(); };
      window.speechSynthesis.speak(utter);
    }
    proxima();
  });
});

(function () {
  var audioAtual = null;
  var btnAtual = null;
  document.querySelectorAll('.bloco-audio').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btnAtual === btn && audioAtual && !audioAtual.paused) {
        audioAtual.pause();
        btn.classList.remove('playing');
        return;
      }
      if (audioAtual) audioAtual.pause();
      if (btnAtual) btnAtual.classList.remove('playing');
      audioAtual = new Audio(btn.dataset.audioUrl);
      btnAtual = btn;
      btn.classList.add('playing');
      audioAtual.onended = function () { btn.classList.remove('playing'); };
      audioAtual.play().catch(function () { btn.classList.remove('playing'); });
    });
  });
})();

// Seletor '[data-register]', não só '.register-btn' — essa classe também está
// nos botões de lacuna/ditado (só pra herdar o CSS), que não têm data-register
// e disparariam TypeError aqui (achado revisando este trecho, 2026-09-09).
