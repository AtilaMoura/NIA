# ============================================================================
# Modelo de variáveis da VM 1 (backend + banco).
#
#   cp .env.backend.example .env      (na VM 1)
#   nano .env                         (preencher os valores reais)
#
# O .env real NUNCA vai pro git (está no .gitignore). Não commite segredo.
# ============================================================================

# ---------- Postgres ----------
POSTGRES_USER=niauser
POSTGRES_DB=niadb
# Gere uma senha forte:  openssl rand -base64 24
POSTGRES_PASSWORD=TROCAR_senha_forte_do_postgres

# ---------- Backend ----------
# Chave de assinatura do JWT. Gere:  openssl rand -hex 32
SECRET_KEY=TROCAR_hex_de_64_caracteres

# Origens permitidas no CORS — os domínios dos fronts (Emaús e, se usar,
# o front tech), separados por vírgula, COM https:// e SEM barra no fim.
CORS_ORIGINS=https://emaus.SEU-DOMINIO

# Chaves de IA (só o Tutor e o Quiz usam em runtime). Deixe em branco se não for
# usar por enquanto — os endpoints de IA respondem 503 amigável.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ---------- Front "tech" (Next) — só se for usar o serviço `frontend` ----------
NEXT_PUBLIC_API_URL=https://api.SEU-DOMINIO

# ---------- Caddy / domínios ----------
SITE_API=api.SEU-DOMINIO
# Deixe em branco se não for subir o front "tech" nesta VM.
SITE_NIA=
# E-mail pro Let's Encrypt avisar de expiração de certificado.
ACME_EMAIL=voce@exemplo.com
