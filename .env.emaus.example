# ============================================================================
# Modelo de variáveis da VM 2 (Emaús).
#
#   cp .env.emaus.example .env      (na VM 2)
#   nano .env                       (preencher os valores reais)
#
# O .env real NUNCA vai pro git (está no .gitignore). Não commite segredo.
# ============================================================================

# ---------- API do backend (VM 1) ----------
# URL PÚBLICA da API — o que o navegador do usuário chama. É embutida no
# bundle em build time, então mudou aqui = rebuildar (`up -d --build`).
NEXT_PUBLIC_API_URL=https://api.SEU-DOMINIO

# URL INTERNA — pelo IP PRIVADO da VM 1 dentro da VCN (não passa pela
# internet). Troque pelo IP privado real da sua VM 1 (`ip -4 addr` nela).
API_URL_INTERNAL=http://10.0.0.28:8000

# ---------- Caddy / domínio ----------
SITE_EMAUS=emaus.SEU-DOMINIO
# E-mail pro Let's Encrypt avisar de expiração de certificado.
ACME_EMAIL=voce@exemplo.com
